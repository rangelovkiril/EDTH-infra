    {
      "id": 6,
      "type": "stat",
      "title": "Broker latency by node",
      "description": "Broker time minus capture time, per node: network delay plus clock offset. Rays pair only within 100 ms, so this should stay small and steady.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-mqtt-datasource",
        "uid": "mqtt"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-mqtt-datasource",
            "uid": "mqtt"
          },
          "topic": "rays/+"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "node": true,
              "latency_ms": true
            }
          }
        },
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "node"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "noValue": "—",
          "displayName": "${__field.labels.node}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
