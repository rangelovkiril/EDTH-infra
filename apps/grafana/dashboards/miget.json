{
  "uid": "miget",
  "title": "M.I.G.E.T. — passive sky watch",
  "description": "Live from MQTT: nodes detect and triangulate, the broker validates, fusion tracks and predicts",
  "tags": [
    "miget",
    "edth"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": true,
  "refresh": "",
  "time": {
    "from": "now-1m",
    "to": "now"
  },
  "timepicker": {},
  "schemaVersion": 41,
  "links": [
    {
      "title": "EMQX dashboard",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "https://emqx.rangelov.dev/"
