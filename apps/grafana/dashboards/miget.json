        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "grafana-mqtt-datasource",
        "uid": "mqtt"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-mqtt-datasource",
            "uid": "mqtt"
          },
          "topic": "fusion/tracks"
        }
      ],
      "transformations": [
